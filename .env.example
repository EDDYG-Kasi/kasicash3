# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kasicash

# App
NODE_ENV=development
PORT=3000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
# PostgreSQL is mandatory in every runtime. Unit tests use mocked services;
# integration tests use a real disposable PostgreSQL container.
KASICASH_DB_MODE=postgres
KASICASH_TRUST_PROXY_HOPS=0
# Local/Codespaces helper endpoint for simulating WhatsApp text without Meta
# webhook signing. Never enable in production.
KASICASH_DEV_TOOLS=false
KASICASH_DEV_TOOLS_TOKEN=

# Auth/security
KASICASH_AUTH_SESSION_TTL_MINUTES=480
# Keep true outside explicit local HTTP development. Production rejects false.
KASICASH_AUTH_COOKIE_SECURE=true
KASICASH_WEBHOOK_MAX_RAW_BYTES=262144
KASICASH_WEBHOOK_REPLAY_TTL_SECONDS=300

# WhatsApp Business Cloud API (Phase 2)
# Use cloud in production. The log client is an explicit development-only mode.
KASICASH_WHATSAPP_MODE=log
# Token you choose; must match the value entered in the Meta App webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Permanent access token + sender phone number id. Both are required in cloud mode.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta Graph API version pinned for outbound sends. Update deliberately after
# sandbox verification; do not rely on an unversioned endpoint.
WHATSAPP_GRAPH_API_VERSION=v24.0
# Outbound send timeout for the best-effort reply side effect.
WHATSAPP_SEND_TIMEOUT_MS=5000

# Ingestion recovery worker: set to 'true' to disable the periodic retry/replay
# loop (e.g. in a process that should not run background jobs). Default: enabled.
INGESTION_RECOVERY_DISABLED=
