# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kasicash

# App
PORT=3000
# Local/Codespaces helper endpoint for simulating WhatsApp text without Meta
# webhook signing. Never enable in production.
KASICASH_DEV_TOOLS=false

# WhatsApp Business Cloud API (Phase 2)
# Token you choose; must match the value entered in the Meta App webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Permanent access token + sender phone number id. If unset, outbound replies
# are logged instead of sent (LoggingWhatsAppClient).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Ingestion recovery worker: set to 'true' to disable the periodic retry/replay
# loop (e.g. in a process that should not run background jobs). Default: enabled.
INGESTION_RECOVERY_DISABLED=
